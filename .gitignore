# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# env
.env

# scratch dir (skill/planning scratchpad, never committed)
.superpowers/

# isolated feature worktrees
.worktrees/

# seed generator's Overpass/OSRM response cache — safe to delete, refetches
scripts/seed/.cache/

# Supabase CLI local link state (machine-specific, recreated by `supabase link`)
supabase/.temp/
