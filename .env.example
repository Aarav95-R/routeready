# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Mapbox public token (pk...) — used at runtime to display the map.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR-PUBLIC-TOKEN

# Mapbox secret DOWNLOAD token (sk... with the DOWNLOADS:READ scope) — used at
# BUILD time to fetch the native SDK. Locally you can set it here; for EAS cloud
# builds set it as a secret instead:  eas secret:create --name MAPBOX_DOWNLOAD_TOKEN --value sk...
MAPBOX_DOWNLOAD_TOKEN=sk.YOUR-DOWNLOAD-TOKEN

# Resend API key, read by supabase/config.toml's `auth.email.smtp.pass = "env(...)"` when the
# Supabase CLI pushes config (`supabase config push`) — not read by the Expo app, so it must NOT
# get an EXPO_PUBLIC_ prefix. Generate one in Resend scoped to sending only. See SETUP.md for the
# rest of the production-email setup (DNS records, linking the project, the push itself).
SUPABASE_AUTH_SMTP_PASS=re_YOUR-RESEND-API-KEY

# RevenueCat iOS *public* SDK key (appl_...). Found at RevenueCat → Project
# Settings → API keys → "Public app-specific API key" for the iOS app. Public
# by design — it identifies the app to RevenueCat and authorises nothing on its
# own, which is why it carries the EXPO_PUBLIC_ prefix that inlines it into the
# bundle. The secret half of RevenueCat lives in the webhook, never here.
#
# A build without it still runs: every function in src/services/purchases.ts
# becomes a no-op reporting an unknown entitlement, so the paywall sheet simply
# shows no plans rather than the app failing at launch. See SETUP.md section 7.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
